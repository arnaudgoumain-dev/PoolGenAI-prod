rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Un compte suspendu perd tout accès à ses propres données, même avec un
    // token encore valide (le champ "suspended" n'est jamais écrit par le client,
    // seulement par toi via la console Firebase ou l'Admin SDK).
    function isSuspended(uid) {
      return exists(/databases/$(database)/documents/suspended/$(uid)) &&
        get(/databases/$(database)/documents/suspended/$(uid)).data.suspended == true;
    }
    function isActiveOwner(uid) {
      return isOwner(uid) && !isSuspended(uid);
    }
    function secondaryLink(primaryUid) {
      return get(/databases/$(database)/documents/users/$(primaryUid)/secondaryUsers/$(request.auth.uid));
    }
    function isActiveSecondary(primaryUid) {
      return request.auth != null &&
        !isSuspended(request.auth.uid) &&
        !isSuspended(primaryUid) &&
        exists(/databases/$(database)/documents/users/$(primaryUid)/secondaryUsers/$(request.auth.uid)) &&
        secondaryLink(primaryUid).data.status == 'active';
    }
    function isActiveSecondaryForPool(primaryUid, poolId) {
      return isActiveSecondary(primaryUid) && secondaryLink(primaryUid).data.poolId == poolId;
    }
    // v1.95.0 — Compte le nombre de bassins ACTIFS (non désactivés en soft
    // delete) dans le tableau "pools" de config/main, pour plafonner à 1
    // (gratuit) ou 3 (Premium).
    function activePoolCount(pools) {
      return (pools.size() > 0  && pools[0].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 1  && pools[1].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 2  && pools[2].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 3  && pools[3].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 4  && pools[4].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 5  && pools[5].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 6  && pools[6].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 7  && pools[7].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 8  && pools[8].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 9  && pools[9].get('disabled', false)  != true ? 1 : 0)
           + (pools.size() > 10 && pools[10].get('disabled', false) != true ? 1 : 0)
           + (pools.size() > 11 && pools[11].get('disabled', false) != true ? 1 : 0)
           + (pools.size() > 12 && pools[12].get('disabled', false) != true ? 1 : 0)
           + (pools.size() > 13 && pools[13].get('disabled', false) != true ? 1 : 0)
           + (pools.size() > 14 && pools[14].get('disabled', false) != true ? 1 : 0);
    }
    function maxActivePools(currentIsPremium) {
      return currentIsPremium ? 3 : 1;
    }
    match /suspended/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isActiveOwner(uid);
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/measures/{docId} {
      allow read, update: if isActiveOwner(uid) || isActiveSecondaryForPool(uid, resource.data.poolId);
      allow create: if isActiveOwner(uid) || isActiveSecondaryForPool(uid, request.resource.data.poolId);
      allow delete: if isOwner(uid) ||
        (isActiveSecondaryForPool(uid, resource.data.poolId) && resource.data.get('createdBy', '') == request.auth.uid);
    }
    match /users/{uid}/measures/{measureId}/photos/{photoId} {
      allow read, create, update: if isActiveOwner(uid) ||
        isActiveSecondaryForPool(uid, get(/databases/$(database)/documents/users/$(uid)/measures/$(measureId)).data.poolId);
      allow delete: if isOwner(uid) ||
        isActiveSecondaryForPool(uid, get(/databases/$(database)/documents/users/$(uid)/measures/$(measureId)).data.poolId);
    }
    match /users/{uid}/applications/{docId} {
      allow read, update: if isActiveOwner(uid) || isActiveSecondaryForPool(uid, resource.data.poolId);
      allow create: if isActiveOwner(uid) || isActiveSecondaryForPool(uid, request.resource.data.poolId);
      allow delete: if isOwner(uid) ||
        (isActiveSecondaryForPool(uid, resource.data.poolId) && resource.data.get('createdBy', '') == request.auth.uid);
    }
    match /users/{uid}/diagnostics/{docId} {
      allow read, create, update: if isActiveOwner(uid);
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/productPhotos/{productId} {
      allow read, create, update: if isActiveOwner(uid) || isActiveSecondary(uid);
      allow delete: if isOwner(uid) || isActiveSecondary(uid);
    }
    match /users/{primaryUid}/secondaryUsers/{secondaryUid} {
      allow read: if isOwner(primaryUid) || isOwner(secondaryUid);
      allow write: if false;
    }
    match /users/{secondaryUid}/linkedAccounts/{primaryUid} {
      allow read: if isOwner(secondaryUid);
      allow write: if false;
    }
    match /invitations/{token} {
      allow read, write: if false;
    }
    match /revocationRequests/{token} {
      allow read, write: if false;
    }
    match /pseudos/{pseudoKey} {
      allow read, write: if false;
    }
    match /users/{uid}/config/main {
      allow read: if isOwner(uid) || isActiveSecondary(uid);
      allow create: if isActiveOwner(uid) &&
        request.resource.data.get('isPremium', false) == false &&
        request.resource.data.get('pools', []).size() <= 15 &&
        activePoolCount(request.resource.data.get('pools', [])) <= maxActivePools(false);
      allow update: if (isActiveOwner(uid) &&
          (request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false) ||
           request.resource.data.get('isPremium', false) == false) &&
          request.resource.data.get('pools', []).size() <= 15 &&
          activePoolCount(request.resource.data.get('pools', [])) <= maxActivePools(resource.data.get('isPremium', false))) ||
        (isActiveSecondary(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['products', 'activePlan', 'updatedAt']) &&
          request.resource.data.get('activePlan', {}).diff(resource.data.get('activePlan', {})).affectedKeys().hasOnly([secondaryLink(uid).data.poolId]));
      allow delete: if isOwner(uid);
    }
    match /calibrationPoints/{docId} {
      allow read: if false;
      allow create: if request.auth != null &&
        !('uid' in request.resource.data) &&
        request.resource.data.keys().hasOnly(
          ['stripModel', 'param', 'sampledColor', 'referenceColor', 'trueValue', 'capturedAt',
           'sharpness', 'exposure', 'exposureClipped', 'padCoverageRatio']
        );
      allow update, delete: if false;
    }
    // v1.100.0 — Lecture retirée du client (servie par le Worker, voir
    // /strip-calibration-model) : ces coefficients entraînés étaient lisibles
    // par tout compte authentifié, y compris gratuit.
    match /calibrationModels/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /commonProducts/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /pendingMerges/{mergeId} {
      allow read, write: if false;
    }

    // v1.97.0 — Fiches de modèles de bandelette (Mareva, AquaChek...).
    // Écriture réservée au script admin (seed-strip-models.js, compte de
    // service, hors périmètre de ces règles) SAUF la promotion automatique
    // de nouvelles fiches (v1.98.9, voir stripModelCandidates ci-dessous)
    // qui écrit en create depuis un client authentifié — jamais d'update
    // depuis un client sur une fiche existante (seule la Console/le script
    // admin corrige une fiche déjà en place).
    // v1.100.0 — Lecture retirée du client (servie par le Worker, voir
    // /strip-reference-data) : ces fiches étaient lisibles par tout compte
    // authentifié, y compris gratuit. "create" conservé (promotion
    // automatique ci-dessus), distincte de la lecture qu'on ferme ici.
    match /stripModels/{modelId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // v1.97.0 — Seuils de confiance par paramètre (config/stripConfidenceThresholds,
    // config/stripConfidenceThresholdsTesters). Collection RACINE "config" —
    // à ne pas confondre avec users/{uid}/config/main. Écriture réservée à
    // la Console/au script admin.
    // v1.100.0 — Lecture retirée du client (servie par le Worker, voir
    // /strip-reference-data) : lisible jusque-là par tout compte
    // authentifié, y compris gratuit.
    match /config/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // v1.97.4 — Échantillons de confiance bandelette, traçables (uid +
    // measureId). Collection RACINE. Create seulement.
    match /stripConfidenceSamples/{docId} {
      allow read: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // v1.98.9 — Fiches candidates de bandelette (auto-enregistrement de
    // nouveaux modèles). Lecture nécessaire au rapprochement ; create pour
    // une nouvelle candidate ; update limité aux champs de
    // confirmation/promotion ; jamais de suppression.
    match /stripModelCandidates/{candidateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmations', 'updatedAt', 'status', 'promotedModelId', 'promotedAt']);
      allow delete: if false;
    }
  }
}
